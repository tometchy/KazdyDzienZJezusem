@model BibleBookListViewModel
@{
    ViewData["Title"] = $"Biblia — {Model.Translation.Code}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="Index" up-follow>Biblia</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Translation.Code</li>
    </ol>
</nav>

<div class="bible-heading">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Przekład</p>
    <h1 class="display-6 fw-semibold">@Model.Translation.Code</h1>
    <p class="lead text-secondary">@Model.Translation.Description</p>
</div>

<div class="book-grid">
    @foreach (var book in Model.Books)
    {
        <a class="book-tile"
           asp-action="Book"
           asp-route-translation="@Model.Translation.Code"
           asp-route-book="@book.Abbreviation"
           up-follow>
            <span class="book-abbreviation">@book.Abbreviation</span>
            <span class="book-name">@book.Name</span>
        </a>
    }
</div>
