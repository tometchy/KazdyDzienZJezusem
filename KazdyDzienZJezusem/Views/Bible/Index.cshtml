@model BibleTranslationListViewModel
@{
    ViewData["Title"] = "Biblia";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Biblia</li>
    </ol>
</nav>

<div class="bible-heading">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Czytanie Pisma</p>
    <h1 class="display-5 fw-semibold">Biblia</h1>
    <p class="lead text-secondary">Wybierz przekład, od którego chcesz rozpocząć.</p>
</div>

<div class="row g-4 bible-card-grid">
    @foreach (var translation in Model.Translations)
    {
        <div class="col-12 col-md-6">
            <a class="card bible-card h-100 text-decoration-none"
               asp-action="Translation"
               asp-route-translation="@translation.Code"
               up-follow>
                <div class="card-body p-4">
                    <span class="bible-card-code">@translation.Code</span>
                    <h2 class="h4 mt-3 mb-2 text-body">@translation.Name</h2>
                    <p class="mb-0 text-secondary">@translation.Description</p>
                </div>
            </a>
        </div>
    }
</div>
