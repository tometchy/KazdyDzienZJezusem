@model TagDetailsViewModel
@{
    ViewData["Title"] = Model.Tag.Name;
}

<div class="bible-heading">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Tag</p>
    <h1 class="display-6 fw-semibold">@Model.Tag.Name</h1>
</div>

<article class="tag-description">@Html.Raw(Model.Tag.DescriptionHtml)</article>

<section class="mt-4">
    <h2 class="h4">Fragments</h2>
    <ul class="tag-fragments">
        @foreach (var fragment in Model.Tag.Fragments)
        {
            <li>@fragment</li>
        }
    </ul>
</section>
