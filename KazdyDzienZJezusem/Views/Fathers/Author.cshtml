@model FatherWorkListViewModel
@{
    ViewData["Title"] = Model.Author.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index" up-follow>Ojcowie</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Author.Name</li>
    </ol>
</nav>

<div class="bible-heading">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Seven Greek letters</p>
    <h1 class="display-5 fw-semibold">@Model.Author.Name</h1>
    <p class="lead text-secondary">Choose a letter.</p>
</div>

<div class="book-grid">
    @foreach (var work in Model.Works)
    {
        <a class="book-tile"
           asp-action="Work"
           asp-route-author="@Model.Author.Code"
           asp-route-work="@work.Abbreviation"
           up-follow>
            <span class="book-abbreviation">@work.Abbreviation</span>
            <span class="book-name">
                <strong>@work.Name</strong><br />
                <span lang="grc">@work.GreekName</span>
            </span>
        </a>
    }
</div>
