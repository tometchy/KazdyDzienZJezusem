@model bool
@{
    ViewData["Title"] = "login";
}
<div class="bible-heading">
    <h1 class="display-6">login</h1>
</div>
@if (ViewData["Error"] is string error)
{
    <p role="alert" class="text-danger mt-3">@error</p>
}
@if (Model)
{
    <p role="status">You are logged in. You can add tags while reading.</p>
    <form action="/logout" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary" type="submit">Log out</button>
    </form>
    <a class="btn btn-link mt-3" href="/Biblia">Bible</a>
    <a class="btn btn-link mt-3" href="/Ojcowie">Church Fathers</a>
}
else
{
    <form action="/login" method="post" class="login-form">
        @Html.AntiForgeryToken()
        <label for="login" class="form-label">login</label>
        <input id="login" name="login" type="password" class="form-control" required
               maxlength="512" autocomplete="off" autocapitalize="none" spellcheck="false" />
        <button class="btn btn-primary mt-3" type="submit">login</button>
    </form>
}
