<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KazdyDzienZJezusem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/unpoly@3.14.3/unpoly.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/unpoly@3.14.3/unpoly.min.js" integrity="sha384-QVFb/ui46etlWAKDfCpK1bbkhf//PILE4C+PcnS9pD2TQfAB4paAejFpHV1VEd6g" crossorigin="anonymous" defer></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KazdyDzienZJezusem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Bible" asp-action="Index" up-follow>KazdyDzienZJezusem</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Bible" asp-action="Index" up-follow>Biblia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Fathers" asp-action="Index" up-follow>Ojcowie</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Teksty" up-follow>Literatura</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Tags" asp-action="Index" up-follow>Tagi</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container greek-reading-controls" lang="en">
            <div class="greek-reading-options">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="greek-polish-toggle"
                       aria-label="Polish above Greek words" aria-describedby="greek-polish-status" />
                <label class="form-check-label" for="greek-polish-toggle">Polish</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="greek-english-toggle"
                       aria-label="English above Greek words" aria-describedby="greek-polish-status" />
                <label class="form-check-label" for="greek-english-toggle">English</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="greek-grammar-toggle"
                       aria-label="Grammar above Greek words" aria-describedby="greek-polish-status" />
                <label class="form-check-label" for="greek-grammar-toggle">Grammar code</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="greek-pronunciation-toggle"
                       aria-label="Pronunciation above Greek words" aria-describedby="greek-polish-status"
                       title="Approximate Polish Erasmian classroom reading; stress and vowel length are omitted." />
                <label class="form-check-label" for="greek-pronunciation-toggle">Pronunciation</label>
            </div>
            </div>
            <p id="greek-polish-status" class="small text-secondary mb-0" aria-live="polite"></p>
            <small id="greek-polish-source" hidden>
                Adapted interlinear data by
                <a href="https://huggingface.co/datasets/mrapacz/greek-interlinear-translations" target="_blank" rel="noopener noreferrer">Maciej Rapacz (Oblubienica / BibleHub)</a>,
                <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="license noopener noreferrer">CC BY-NC-SA 4.0</a>.
                <span id="greek-supplement-source" hidden>
                    Additional data: <a href="https://github.com/Clear-Bible/macula-greek" target="_blank" rel="noopener noreferrer">MACULA Greek Linguistic Datasets (Biblica / Clear Bible)</a>,
                    <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener noreferrer">CC BY 4.0</a>;
                    <a href="https://kaikki.org/dictionary/Ancient%20Greek/index.html" target="_blank" rel="noopener noreferrer">Wiktionary contributors / Kaikki</a>,
                    <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener noreferrer">CC BY-SA 4.0</a>.
                    Definitions also use the bundled GNT lexicon.
                    <span id="greek-perseus-source" hidden>
                        <a href="https://www.perseus.tufts.edu/" target="_blank" rel="noopener noreferrer">Perseus Digital Library / Tufts (Morpheus)</a>,
                        <a href="https://creativecommons.org/licenses/by-sa/3.0/us/" target="_blank" rel="license noopener noreferrer">CC BY-SA 3.0 US</a>;
                        <a href="https://github.com/helmadik/LSJLogeion" target="_blank" rel="noopener noreferrer">LSJ / Logeion (Helma Dik)</a>,
                        <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener noreferrer">CC BY-SA 4.0</a>,
                        adapted from <a href="https://github.com/pjheslin/diogenes-prebuilt-data" target="_blank" rel="noopener noreferrer">Diogenes (Peter J. Heslin)</a>.
                    </span>
                    † Dictionary meaning, not an inflected translation.
                </span>
            </small>
        </div>
    </header>
    <div class="container">
        <main id="main-content" role="main" class="pb-3" up-main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - KazdyDzienZJezusem
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/greek-interlinear.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
